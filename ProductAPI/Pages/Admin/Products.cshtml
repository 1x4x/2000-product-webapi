@page "/admin/products"
@model ProductAPI.Pages.Admin.ProductsModel
<h1>Products &amp; pricing</h1><p class="muted">Edit products by entering their ID from the table. Stock adjustments belong in Inventory.</p>
<div class="card"><h2>Create or edit product</h2><form method="post" asp-page-handler="Save" class="gridform">
<label>Product ID (0 = new)<input asp-for="Input.Id" type="number" min="0"/></label><label>SKU<input asp-for="Input.Sku" required maxlength="80"/></label><label>Name<input asp-for="Input.Name" required maxlength="200"/></label>
<label>Category<select asp-for="Input.CategoryId"><option value="">Uncategorized</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></label>
<label>Supplier<select asp-for="Input.SupplierId"><option value="">Not assigned</option>@foreach(var s in Model.Suppliers){<option value="@s.Id">@s.Name</option>}</select></label>
<label>Purchase price<input asp-for="Input.PurchasePrice" type="number" min="0" step="0.01" required/></label><label>Retail price<input asp-for="Input.RetailPrice" type="number" min="0" step="0.01" required/></label><label>Reseller price<input asp-for="Input.ResellerPrice" type="number" min="0" step="0.01" required/></label>
<label>Currency<input asp-for="Input.Currency" maxlength="3" required/></label><label>Target stock<input asp-for="Input.TargetStockQuantity" type="number" min="1" required/></label><label>Reorder threshold %<input asp-for="Input.ReorderThresholdPercent" type="number" min="1" max="100" required/></label><label>Fixed reorder qty (0 = top up)<input asp-for="Input.ReorderQuantity" type="number" min="0"/></label>
<label>Description<textarea asp-for="Input.Description" rows="2"></textarea></label><label>Active<input asp-for="Input.Active" type="checkbox"/></label><div><button>Save product</button></div></form><p class="error">@Model.Error</p></div>
<div class="card"><h2>Add category</h2><form method="post" asp-page-handler="Category"><input asp-for="CategoryName" placeholder="Category name" required maxlength="120"/><button>Add category</button></form></div>
<div class="card"><h2>Products</h2><table><thead><tr><th>ID / SKU</th><th>Name</th><th>Supplier</th><th>Purchase</th><th>Retail</th><th>Reseller</th><th>Available / target</th><th>Reorder</th></tr></thead><tbody>@foreach(var p in Model.Items){var available=p.StockQuantity-p.ReservedQuantity;var low=(long)available*100<=(long)p.TargetStockQuantity*p.ReorderThresholdPercent;<tr><td>@p.Id / @p.Sku</td><td>@p.Name @if(!p.Active){<span class="pill">Inactive</span>}</td><td>@(p.Supplier?.Name??"—")</td><td>@p.PurchasePrice @p.Currency</td><td>@p.RetailPrice</td><td>@p.ResellerPrice</td><td class="@(low?"warn":"ok")">@available / @p.TargetStockQuantity</td><td>@if(low&&p.SupplierId.HasValue){<form method="post" action="/admin/purchaseorders?handler=FromProduct"><input type="hidden" name="productId" value="@p.Id"/>@Html.AntiForgeryToken()<button>Draft reorder</button></form>}</td></tr>}</tbody></table></div>
