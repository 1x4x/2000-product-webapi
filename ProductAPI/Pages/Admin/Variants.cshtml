@page "/admin/products/{id:int}/variants"
@model ProductAPI.Pages.Admin.VariantsModel
<h1>Variants · @Model.Product.Name</h1>
<p><a href="/admin/products">Back to products</a></p>
@if(Model.Error!=""){<p class="error">@Model.Error</p>}
<div class="card"><h2>Add variant</h2><form method="post" asp-page-handler="Create" class="gridform">
<label>SKU<input name="sku" maxlength="80" required/></label>
<label>Color<input name="color" maxlength="80"/></label>
<label>Size<input name="size" maxlength="80"/></label>
<label>Material<input name="material" maxlength="80"/></label>
<label>Retail price<input name="retail" type="number" step="0.01" min="0" required/></label>
<label>Reseller price<input name="reseller" type="number" step="0.01" min="0" required/></label>
<button>Add variant</button></form></div>
<div class="card"><h2>Variants</h2><p class="muted">Adjust variant stock through the warehouse inventory workflow.</p>
<table><thead><tr><th>SKU</th><th>Color</th><th>Size</th><th>Material</th><th>Retail</th><th>Reseller</th><th>Available</th><th>Status</th></tr></thead><tbody>
@foreach(var v in Model.Variants){<tr><td>@v.Sku</td><td>@v.Color</td><td>@v.Size</td><td>@v.Material</td><td>@v.RetailPrice</td><td>@v.ResellerPrice</td><td>@(v.StockQuantity-v.ReservedQuantity)</td><td>@(v.Active?"Active":"Inactive")</td></tr>}
</tbody></table></div>
