@page "/admin/products/{id:int}/images"
@model ProductAPI.Pages.Admin.ProductImagesModel
<h1>Images for @Model.Product.Name</h1>
<p><a href="/admin/products">← Back to products</a></p>
<p class="muted">Upload up to 20 JPEG, PNG or WebP images per product. Maximum 5 MB each. The first image becomes primary automatically.</p>
@if(!string.IsNullOrWhiteSpace(Model.Error)){<p class="error">@Model.Error</p>}
<div class="card">
<h2>Upload images (@Model.Images.Count / 20)</h2>
<form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
<input type="file" name="files" accept="image/jpeg,image/png,image/webp" multiple required/>
<button>Upload</button>
</form>
</div>
<div class="card">
<h2>Gallery</h2>
<p class="muted">Drag an image card onto another card to reorder the gallery, or use the arrow buttons.</p>\n<form id="image-order-form" method="post" asp-page-handler="Reorder"><input type="hidden" name="order" id="image-order-value"/></form>\n<div id="image-gallery" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:18px">
@foreach(var img in Model.Images){
<div class="image-card" draggable="true" data-image-id="@img.Id" style="background:#0f172a;border:1px solid #334155;border-radius:8px;padding:12px">
<img src="@img.ImageUrl" alt="@img.AltText" loading="lazy" style="width:100%;height:155px;object-fit:contain"/>
<p>@(img.IsPrimary?"⭐ Primary image":$"Position {img.SortOrder+1}")</p>
<form method="post" asp-page-handler="Alt"><input type="hidden" name="imageId" value="@img.Id"/><input name="altText" value="@img.AltText" maxlength="255" placeholder="Alt text"/><button>Save text</button></form>
<div class="actions">
@if(!img.IsPrimary){<form method="post" asp-page-handler="Primary"><input type="hidden" name="imageId" value="@img.Id"/><button>Make primary</button></form>}
<form method="post" asp-page-handler="Move"><input type="hidden" name="imageId" value="@img.Id"/><input type="hidden" name="direction" value="-1"/><button>↑</button></form>
<form method="post" asp-page-handler="Move"><input type="hidden" name="imageId" value="@img.Id"/><input type="hidden" name="direction" value="1"/><button>↓</button></form>
<form method="post" asp-page-handler="Delete"><input type="hidden" name="imageId" value="@img.Id"/><button class="danger">Delete</button></form>
</div>
</div>}
</div>
</div>

<script>
(() => {
 const gallery = document.getElementById('image-gallery');
 let dragging = null;
 gallery?.addEventListener('dragstart', event => {
   const card = event.target.closest('.image-card');
   if (!card) return;
   dragging = card;
   event.dataTransfer.effectAllowed = 'move';
 });
 gallery?.addEventListener('dragover', event => {
   if (dragging && event.target.closest('.image-card')) event.preventDefault();
 });
 gallery?.addEventListener('drop', event => {
   const target = event.target.closest('.image-card');
   if (!dragging || !target || dragging === target) return;
   event.preventDefault();
   const cards = [...gallery.querySelectorAll('.image-card')];
   const from = cards.indexOf(dragging), to = cards.indexOf(target);
   if (from < to) target.after(dragging); else target.before(dragging);
   document.getElementById('image-order-value').value =
     [...gallery.querySelectorAll('.image-card')].map(x => x.dataset.imageId).join(',');
   document.getElementById('image-order-form').submit();
 });
 gallery?.addEventListener('dragend', () => { dragging = null; });
})();
</script>
