@page "/admin"
@model ProductAPI.Pages.Admin.IndexModel
<h1>Dashboard</h1><div class="cards"><div class="card"><div class="muted">Products</div><div class="number">@Model.Products</div></div><div class="card"><div class="muted">Low-stock products</div><div class="number warn">@Model.LowStock</div></div><div class="card"><div class="muted">Active resellers</div><div class="number">@Model.Resellers</div></div><div class="card"><div class="muted">Active tokens</div><div class="number">@Model.Tokens</div></div></div><div class="card"><h2>Inventory alerts</h2><table><tr><th>SKU</th><th>Product</th><th>Available</th><th>Target</th></tr>@foreach(var p in Model.Alerts){<tr><td>@p.Sku</td><td>@p.Name</td><td class="warn">@(p.StockQuantity-p.ReservedQuantity)</td><td>@p.TargetStockQuantity</td></tr>}</table></div>
