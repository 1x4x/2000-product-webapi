@page "/admin/tokens"
@model ProductAPI.Pages.Admin.TokensModel
<h1>API token management</h1><div class="card"><h2>Create API token</h2><form method="post"><label>Name <input name="Name" required maxlength="150"/></label><label>Owner <select name="ResellerId"><option value="">Internal administrator</option>@foreach(var r in Model.Resellers){<option value="@r.Id">@r.Name</option>}</select></label><label>Expires after days <input name="Days" type="number" min="1" max="3650" value="90" required/></label><h2>Permissions</h2>@foreach(var s in Model.AvailableScopes){<label><input type="checkbox" name="Scopes" value="@s"/> @s</label>}<p class="muted">Internal admin tokens can use admin-only scopes. Reseller tokens cannot.</p><p><button>Create token</button></p></form><p class="error">@Model.Error</p>@if(Model.NewSecret!=null){<div class="secret"><b>Copy this secret now. It will never be displayed again.</b><p>@Model.NewSecret</p></div>}</div><div class="card"><h2>Existing tokens</h2><table><tr><th>Name</th><th>Prefix</th><th>Owner</th><th>Scopes</th><th>Expires UTC</th><th>Status</th><th>Action</th></tr>@foreach(var k in Model.Items){<tr><td>@k.Name</td><td>@k.Prefix…</td><td>@(k.IsAdmin?"Internal":k.Reseller?.Name)</td><td>@k.Scopes</td><td>@k.ExpiresUtc.ToString("yyyy-MM-dd")</td><td>@(k.Revoked?"Revoked":k.ExpiresUtc<=DateTime.UtcNow?"Expired":"Active")</td><td>@if(!k.Revoked){<form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@k.Id"/><button class="danger">Revoke</button></form>}</td></tr>}</table></div>
