@page "/admin/purchaseorders/{id:long}"
@model ProductAPI.Pages.Admin.PurchaseOrderDetailModel
<h1>Purchase order #@Model.Order.Id</h1><p><a href="/admin/purchaseorders">← All purchase orders</a></p><p class="error">@Model.Error</p>
<div class="card"><h2>@Model.Order.Supplier.Name <span class="pill">@Model.Order.Status</span></h2><p class="muted">Contact: @Model.Order.Supplier.Email · Lead time: @Model.Order.Supplier.LeadTimeDays days · Country: @Model.Order.Supplier.Country</p><p>Reference: @(Model.Order.Reference??"—")</p><p>Notes: @(Model.Order.Notes??"—")</p><p>Created: @Model.Order.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</p></div>
<div class="card"><h2>Order lines</h2><table><thead><tr><th>Product</th><th>Ordered</th><th>Received</th><th>Unit cost</th><th>Line total</th><th>Action</th></tr></thead><tbody>@foreach(var i in Model.Order.Items){<tr><td>@i.Product.Sku — @i.Product.Name</td><td>@i.Quantity</td><td>@i.ReceivedQuantity</td><td>@i.UnitCost @i.Product.Currency</td><td>@(i.Quantity*i.UnitCost) @i.Product.Currency</td><td>@if(Model.Order.Status=="Draft"){<form method="post" asp-page-handler="Remove"><input type="hidden" name="itemId" value="@i.Id"/><button class="danger">Remove</button></form>}else if(Model.Order.Status=="Ordered"||Model.Order.Status=="PartiallyReceived"){<form method="post" asp-page-handler="Receive"><input type="hidden" name="itemId" value="@i.Id"/><input name="quantity" type="number" min="1" max="@(i.Quantity-i.ReceivedQuantity)" value="@(i.Quantity-i.ReceivedQuantity)" required/><button>Receive units</button></form>}</td></tr>}</tbody></table></div>
@if(Model.Order.Status=="Draft"){
<div class="card"><h2>Add product from this supplier</h2><form method="post" asp-page-handler="Add" class="gridform"><label>Product<select name="productId" required>@foreach(var p in Model.AvailableProducts){<option value="@p.Id">@p.Sku — @p.Name (@p.PurchasePrice @p.Currency)</option>}</select></label><label>Quantity<input name="quantity" type="number" min="1" value="1" required/></label><label>Unit cost<input name="unitCost" type="number" min="0" step="0.01" value="0" required/></label><div><button>Add line</button></div></form></div>
<div class="card"><h2>Mark order as placed</h2><p class="warn">This records that you placed the order with the supplier. It does NOT send an email or place an external purchase.</p><form method="post" asp-page-handler="Order"><input name="reference" placeholder="Supplier order reference" maxlength="150"/><textarea name="notes" placeholder="Shipping / payment notes" maxlength="2000"></textarea><button>Mark as ordered</button></form></div>
}
@if(Model.Order.Status=="Draft"||Model.Order.Status=="Ordered"){<div class="card"><form method="post" asp-page-handler="Cancel"><button class="danger">Cancel order</button></form></div>}
