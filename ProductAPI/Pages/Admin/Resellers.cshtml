@page "/admin/resellers"
@model ProductAPI.Pages.Admin.ResellersModel
<h1>Resellers</h1><div class="card"><form method="post"><input name="Name" placeholder="Company name" required/><input name="Email" type="email" placeholder="Contact email"/><button>Add reseller</button></form></div><div class="card"><table><tr><th>Company</th><th>Email</th><th>Status</th><th>Action</th></tr>@foreach(var r in Model.Items){<tr><td>@r.Name</td><td>@r.Email</td><td>@(r.Active?"Active":"Disabled")</td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@r.Id"/><button class="@(r.Active?"danger":"")">@(r.Active?"Disable":"Enable")</button></form></td></tr>}</table></div>
