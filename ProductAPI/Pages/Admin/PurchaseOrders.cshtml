@page "/admin/purchaseorders"
@model ProductAPI.Pages.Admin.PurchaseOrdersModel
<h1>Supplier purchase orders</h1><p class="muted">Low-stock products can be converted into draft supplier orders. Drafts do not contact suppliers.</p><p class="error">@Model.Error</p>
<div class="card"><h2>Products needing replenishment</h2><table><thead><tr><th>Product</th><th>Supplier</th><th>Available</th><th>Target</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.LowStock){<tr><td>@x.Sku — @x.Name</td><td>@x.Supplier?.Name</td><td class="warn">@(x.StockQuantity-x.ReservedQuantity)</td><td>@x.TargetStockQuantity</td><td><form method="post" asp-page-handler="FromProduct"><input type="hidden" name="productId" value="@x.Id"/><button>Draft reorder</button></form></td></tr>}</tbody></table></div>
<div class="card"><h2>New blank purchase order</h2><form method="post" asp-page-handler="Create"><select asp-for="SupplierId" required><option value="">Select supplier</option>@foreach(var s in Model.Suppliers){<option value="@s.Id">@s.Name</option>}</select><button>Create draft</button></form></div>
<div class="card"><h2>Recent purchase orders</h2><table><thead><tr><th>PO</th><th>Supplier</th><th>Status</th><th>Created (UTC)</th><th>Lines</th><th></th></tr></thead><tbody>@foreach(var o in Model.Orders){<tr><td>#@o.Id</td><td>@o.Supplier.Name</td><td><span class="pill">@o.Status</span></td><td>@o.CreatedUtc.ToString("yyyy-MM-dd")</td><td>@o.Items.Count</td><td><a href="/admin/purchaseorders/@o.Id">Open</a></td></tr>}</tbody></table></div>
