@page "/admin/inventory"
@model ProductAPI.Pages.Admin.InventoryModel
<h1>Inventory management</h1><p class="muted">Low stock is based on available quantity (on hand minus reserved) versus target stock.</p><div class="card"><table><tr><th>Product</th><th>On hand</th><th>Reserved</th><th>Target</th><th>Warning</th><th>Adjust stock</th></tr>@foreach(var p in Model.Items){var low=p.TargetStockQuantity>0&&(p.StockQuantity-p.ReservedQuantity)*100<=p.TargetStockQuantity*p.ReorderThresholdPercent;<tr><td>@p.Name</td><td>@p.StockQuantity</td><td>@p.ReservedQuantity</td><td>@p.TargetStockQuantity</td><td class="@(low?"warn":"ok")">@(low?"Reorder":"OK")</td><td><form method="post"><input type="hidden" name="productId" value="@p.Id"/><input type="number" name="delta" placeholder="+/- units" required style="width:115px"/><input name="reason" placeholder="Reason" required/><button>Apply</button></form></td></tr>}</table><p class="error">@Model.Error</p></div>
