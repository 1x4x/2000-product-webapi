<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>ProductAPI Admin</title><style>
:root{color-scheme:dark;font-family:system-ui,Segoe UI,sans-serif;background:#0b1220;color:#e5e7eb}*{box-sizing:border-box}body{margin:0}header{background:#111c30;padding:18px 5%;border-bottom:1px solid #2c3c55;display:flex;align-items:center;justify-content:space-between}header b{color:#93c5fd;font-size:21px}nav a{margin-left:18px;color:#cbd5e1;text-decoration:none}nav a:hover{color:#fff}main{max-width:1200px;margin:30px auto;padding:0 22px}h1{font-size:27px}h2{font-size:19px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px}.card{background:#17243a;border:1px solid #2c3c55;padding:20px;border-radius:12px;margin-bottom:16px}.number{font-size:30px;font-weight:700}.muted{color:#94a3b8}table{width:100%;border-collapse:collapse}th,td{text-align:left;border-bottom:1px solid #334155;padding:12px}input,select,textarea{background:#0f172a;color:#fff;border:1px solid #475569;border-radius:6px;padding:10px;margin:5px;max-width:100%}button,.btn{background:#2563eb;color:white;border:0;border-radius:6px;padding:10px 15px;cursor:pointer}button.danger{background:#991b1b}label{display:inline-block;margin:7px}.warn{color:#fbbf24}.ok{color:#34d399}.secret{background:#052e2b;border:1px solid #10b981;padding:15px;overflow-wrap:anywhere}.error{color:#fca5a5}form.inline{display:inline}.gridform{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}.gridform label{display:flex;flex-direction:column;gap:4px}.gridform input,.gridform select,.gridform textarea{margin:0}.actions{display:flex;gap:10px;flex-wrap:wrap}.pill{padding:4px 9px;border-radius:20px;background:#334155}.small{font-size:13px}
</style></head><body><header><b>◈ ProductAPI</b><nav><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/inventory">Inventory</a><a href="/admin/suppliers">Suppliers</a><a href="/admin/purchaseorders">Purchase Orders</a><a href="/admin/resellers">Resellers</a><a href="/admin/tokens">API Tokens</a>@if(User.Identity?.IsAuthenticated==true){<form class="inline" method="post" action="/logout"><button>Sign out</button>@Html.AntiForgeryToken()</form>}</nav></header><main>@RenderBody()</main></body></html>
